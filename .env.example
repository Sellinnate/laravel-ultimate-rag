# =============================================================================
# sellinnate/rag-engine — environment variables
# -----------------------------------------------------------------------------
# Copy the lines you need into your app's .env. API keys ALWAYS live here, never
# in config/rag-engine.php (that file is committed and config:cache-safe).
# Only set the providers you actually use; everything has a sane default.
# =============================================================================

# --- Defaults: which driver each stage uses -------------------------------
RAG_EMBEDDER=fake          # openai | azure-openai | mistral | jina | voyage | cohere | gemini | huggingface | ollama | fake
RAG_VECTOR_STORE=memory    # memory | database | pgvector | qdrant
RAG_LLM=null               # null | fake | anthropic | openai (for ask()/generation)
RAG_RERANKER=null          # null | fake | cohere | jina
RAG_TOKENIZER=approximate
RAG_OCR=null               # null | tesseract | <your extend() driver> (OCR for scanned PDFs and images)
# RAG_OCR_LANG=eng                   # tesseract language(s)
# RAG_OCR_MIN_CHARS=16               # below this extracted length, OCR the PDF
# RAG_TESSERACT_BIN=tesseract
# RAG_PDFTOPPM_BIN=pdftoppm

# =============================================================================
# Embedding providers — set the key(s) for the provider(s) you use.
# =============================================================================

# --- OpenAI (global; mandatory baseline) ----------------------------------
RAG_OPENAI_API_KEY=
# RAG_OPENAI_MODEL=text-embedding-3-small
# RAG_OPENAI_DIMENSIONS=1536
# RAG_OPENAI_ORG=                 # optional OpenAI-Organization header
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_COST_PER_1K=0.00002

# --- Azure OpenAI (EU-resident in an EU region) ---------------------------
RAG_AZURE_API_KEY=
RAG_AZURE_ENDPOINT=https://<resource>.openai.azure.com
RAG_AZURE_DEPLOYMENT=<your-embedding-deployment>
RAG_AZURE_API_VERSION=2024-02-01
# RAG_AZURE_MODEL=text-embedding-3-small
# RAG_AZURE_DIMENSIONS=1536

# --- Mistral (EU) ----------------------------------------------------------
RAG_MISTRAL_API_KEY=
# RAG_MISTRAL_MODEL=mistral-embed
# RAG_MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Jina AI (EU) ----------------------------------------------------------
RAG_JINA_API_KEY=
# RAG_JINA_MODEL=jina-embeddings-v3
# RAG_JINA_DIMENSIONS=1024
# RAG_JINA_TASK=retrieval.passage   # retrieval.passage | retrieval.query | ...

# --- Voyage AI (global) ----------------------------------------------------
RAG_VOYAGE_API_KEY=
# RAG_VOYAGE_MODEL=voyage-3
# RAG_VOYAGE_DIMENSIONS=1024
# RAG_VOYAGE_INPUT_TYPE=document    # document | query

# --- Cohere (global) -------------------------------------------------------
RAG_COHERE_API_KEY=
# RAG_COHERE_MODEL=embed-multilingual-v3.0
# RAG_COHERE_DIMENSIONS=1024
# RAG_COHERE_INPUT_TYPE=search_document   # search_document | search_query

# --- Google Gemini (global) ------------------------------------------------
RAG_GEMINI_API_KEY=
# RAG_GEMINI_MODEL=text-embedding-004
# RAG_GEMINI_DIMENSIONS=768

# --- Hugging Face (global API, or self-hosted TEI) -------------------------
RAG_HF_API_KEY=
# RAG_HF_MODEL=BAAI/bge-small-en-v1.5
# RAG_HF_DIMENSIONS=384
# RAG_HF_BASE_URL=https://api-inference.huggingface.co

# --- Ollama (self-hosted; no API key) -------------------------------------
RAG_OLLAMA_BASE_URL=http://localhost:11434
# RAG_OLLAMA_MODEL=nomic-embed-text
# RAG_OLLAMA_DIMENSIONS=768

# =============================================================================
# LLM providers — used by Rag::ask() to write answers (generation only).
# Set RAG_LLM above to choose the default. Anthropic has no embedding API, so
# it is generation-only; keep a real RAG_EMBEDDER for the search side.
# =============================================================================

# --- Anthropic (Claude) ---------------------------------------------------
RAG_ANTHROPIC_API_KEY=
# RAG_ANTHROPIC_MODEL=claude-sonnet-4-6        # or claude-opus-4-8 / claude-haiku-4-5-...
# RAG_ANTHROPIC_MAX_TOKENS=1024
# RAG_ANTHROPIC_BASE_URL=https://api.anthropic.com
# RAG_ANTHROPIC_VERSION=2023-06-01

# --- OpenAI / OpenAI-compatible (Mistral, Ollama /v1, Groq, OpenRouter) ----
RAG_OPENAI_LLM_API_KEY=
# RAG_OPENAI_LLM_MODEL=gpt-4o-mini
# RAG_OPENAI_LLM_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_LLM_MAX_TOKENS=1024

# =============================================================================
# Rerankers — optional cross-encoder pass that improves result ordering.
# Set RAG_RERANKER above to choose the default. Cohere/Jina reuse their
# embedding keys by default; override here if the rerank key differs.
# =============================================================================
# RAG_COHERE_RERANK_API_KEY=          # falls back to RAG_COHERE_API_KEY
# RAG_COHERE_RERANK_MODEL=rerank-v3.5
# RAG_JINA_RERANK_API_KEY=            # falls back to RAG_JINA_API_KEY
# RAG_JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# =============================================================================
# Vector store — where embeddings are stored & searched.
#   memory   : in-process, for tests/dev (nothing to configure)
#   database : portable SQL store (any connection; brute-force in PHP)
#   pgvector : NATIVE Postgres ANN (vector column + HNSW + <=> operators)
#   qdrant   : Qdrant server (best at scale)
# Full setup guide: https://laravel-rag-engine.selli.io/concepts/vector-stores
# =============================================================================

# --- database (portable SQL): which connection from config/database.php. ---
# Leave unset to use your app's default connection.
# RAG_DB_VECTOR_CONNECTION=pgsql

# --- pgvector (native): a Postgres connection that has the `vector` extension. ---
# RAG_PGVECTOR_CONNECTION must match a connection in config/database.php.
# RAG_PGVECTOR_DIMENSIONS MUST equal your embedding model's output size.
# RAG_PGVECTOR_CONNECTION=pgsql
# RAG_PGVECTOR_DIMENSIONS=1536
# RAG_PGVECTOR_INDEX=hnsw             # hnsw | ivfflat
# RAG_PGVECTOR_TABLE=rag_pgvectors

# --- Qdrant ---
RAG_QDRANT_HOST=http://localhost:6333
RAG_QDRANT_API_KEY=
# RAG_QDRANT_QUANTIZATION=            # scalar | binary | (unset = full precision)

# =============================================================================
# Security, tenancy & ingestion
# =============================================================================
RAG_ENCRYPTION_ENABLED=true
# Copy chunk plaintext into the vector store? unset = only when encryption is off
# (secure default); true = always (pre-v1.3 behaviour); false = never.
# RAG_VECTOR_PAYLOAD_CONTENT=
# Database WORM triggers on the audit table; set false BEFORE migrating on hosts
# that reject CREATE TRIGGER (the model-level guard stays on).
# RAG_AUDIT_DB_TRIGGERS=true
RAG_KMS=local                        # local | aws
# --- local KMS ---
# RAG_KMS_STORE=array               # array (tests) | file (single node) | database (multi-node)
# RAG_KMS_MASTER_KEY=               # >= 32 chars; REQUIRED for database, optional for file
#                                   #   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# RAG_KMS_KEYSTORE=                 # directory for store=file
# RAG_KMS_CONNECTION=               # DB connection holding rag_kms_keys (store=database; default connection when unset)
# --- AWS KMS (production BYOK; needs aws/aws-sdk-php) ---
# RAG_AWS_KMS_REGION=eu-west-1      # falls back to AWS_DEFAULT_REGION
# RAG_AWS_KMS_KEY=                  # falls back to AWS chain (env/profile/IAM role)
# RAG_AWS_KMS_SECRET=
# RAG_AWS_KMS_ALIAS_PREFIX=alias/rag-
# RAG_AWS_KMS_DELETION_WINDOW=7     # days (AWS enforces 7–30)

RAG_PII_REDACTION=true
RAG_PII_STRATEGY=mask               # mask | tokenize

RAG_TENANCY_ISOLATION=namespace      # only 'namespace' is supported today
RAG_TENANCY_STRICT=false
RAG_DEFAULT_TENANT=default

# RAG_QUEUE=default                   # queue that indexing jobs run on
# RAG_MAX_UPLOAD_BYTES=26214400

# =============================================================================
# Eloquent model embedding (HasEmbeddings trait)
# =============================================================================
RAG_ELOQUENT_AUTO_SYNC=true           # re-index models on save, remove on delete
RAG_ELOQUENT_QUEUE=false              # (re)index on a queue instead of inline
# RAG_ELOQUENT_MAX_DEPTH=3            # how deep to compose related models
# RAG_ELOQUENT_NAMESPACE=             # null = share the default vector namespace
# --- file fields (addFile): handling of non-embeddable files (zip/exe/…) ---
RAG_ELOQUENT_ON_UNPARSABLE_FILE=skip  # skip | fail
# RAG_ELOQUENT_MAX_FILE_BYTES=26214400
